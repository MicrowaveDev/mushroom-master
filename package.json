{
  "name": "telegram-mushroom-archiver",
  "version": "1.0.0",
  "description": "Fetch Telegram channel messages, OCR screenshots, repost extracted text, archive markdown, and export mushroom lore PDFs.",
  "type": "module",
  "scripts": {
    "fetch": "node src/index.js",
    "regenerate": "node src/regenerate-from-telegram.js",
    "update-text-message": "node src/update-text-message.js",
    "set-message-hashtags": "node src/set-message-hashtags.js",
    "set-ocr-hashtags": "node src/set-ocr-hashtags.js",
    "clear-message-hashtags": "node src/clear-message-hashtags.js",
    "backfill-posted-message-ids": "node src/backfill-posted-message-ids.js",
    "rebuild-ocr-reposts": "node src/rebuild-ocr-reposts.js",
    "clean-text-duplicates": "node src/clean-text-duplicates.js",
    "analyze:lore-prompt": "node src/analyze-lore-prompt.js",
    "analyze:pdf-structure": "node src/analyze-pdf-structure.js",
    "audit:untagged": "node src/audit-untagged-routing.js",
    "game:start": "node app/scripts/start-game-dev.js",
    "game:start:backend": "node app/server/start.js",
    "game:build": "vite build --config web/vite.config.js",
    "game:artifacts:generate": "node app/scripts/generate-artifact-bitmaps.js",
    "game:artifacts:next": "node app/scripts/next-artifact-image-prompts.js",
    "game:artifacts:produce": "node app/scripts/produce-artifact-bitmaps.js",
    "game:artifacts:release-check": "node app/scripts/run-artifact-release-check.js",
    "game:artifacts:sheet": "node app/scripts/generate-artifact-contact-sheet.js",
    "game:artifacts:thumbnail-review": "node app/scripts/generate-artifact-thumbnail-review.js",
    "game:artifacts:normalize-detail": "node app/scripts/normalize-artifact-detail.js",
    "game:artifacts:provenance:generate": "node app/scripts/generate-artifact-image-metadata.js",
    "game:artifacts:provenance:check": "node app/scripts/check-artifact-image-provenance.js",
    "game:artifacts:validate": "node app/scripts/validate-artifact-image-coverage.js",
    "game:season:next": "node app/scripts/next-season-image-prompts.js",
    "game:season:sheet": "node app/scripts/generate-season-contact-sheet.js",
    "game:season:provenance:generate": "node app/scripts/generate-season-image-metadata.js",
    "game:season:provenance:check": "node app/scripts/check-season-image-provenance.js",
    "game:season:validate": "node app/scripts/validate-season-image-coverage.js",
    "game:season:recalculate": "node app/scripts/recalculate-season-progress.js",
    "game:season:inspect": "node app/scripts/inspect-season-ranks.js",
    "game:season:analytics": "node app/scripts/summarize-season-rank-analytics.js",
    "game:season:archive": "node app/scripts/archive-season.js",
    "game:home-field:next": "node app/scripts/next-home-field-image-prompts.js",
    "game:home-field:next-tiles": "node app/scripts/next-home-field-image-prompts.js --batch=terrain-grass --review-verdict=needs_regen --all",
    "game:home-field:rerun-grass": "node app/scripts/next-home-field-image-prompts.js --batch=terrain-grass --review-verdict=needs_review,needs_regen --all --ignore-review-gate",
    "game:home-field:rerun-grass-field": "node app/scripts/next-home-field-image-prompts.js --batch=terrain-grass --review-verdict=needs_review,needs_regen --all --ignore-review-gate --field-context",
    "game:home-field:rerun-grass-family": "node app/scripts/next-home-field-grass-family-prompt.js",
    "game:home-field:next-tiles-all": "node app/scripts/next-home-field-image-prompts.js --batch=terrain-production --review-verdict=needs_regen --all",
    "game:home-field:proof-tiles": "node app/scripts/generate-home-field-proof-tiles.js",
    "game:home-field:produce": "node app/scripts/produce-home-field-assets.js",
    "game:home-field:produce-object-candidate": "node app/scripts/produce-home-field-assets.js --candidate --candidate-root=.agent/home-field-workspace/candidates/object-layer/latest",
    "game:home-field:produce-grass-family": "node app/scripts/produce-home-field-grass-family.js",
    "game:home-field:produce-grass-family-candidate": "node app/scripts/produce-home-field-grass-family.js --candidate",
    "game:home-field:validate": "node app/scripts/validate-home-field-assets.js",
    "game:home-field:sheet": "node app/scripts/generate-home-field-contact-sheet.js",
    "game:home-field:alpha-sheet": "node app/scripts/generate-home-field-alpha-sheet.js",
    "game:home-field:mobile-readability-sheet": "node app/scripts/generate-home-field-mobile-readability-sheet.js",
    "game:home-field:grass-family-sheet": "node app/scripts/generate-home-field-grass-family-sheet.js",
    "game:home-field:adjacency": "node app/scripts/generate-home-field-adjacency-sheet.js",
    "game:home-field:candidate-preview": "HOME_FIELD_CANDIDATE_PREVIEW=1 HOME_FIELD_CANDIDATE_ROOT=.agent/home-field-workspace/candidates/grass-family/latest npx playwright test --config=tests/game/playwright.config.js tests/game/home-field-candidate-preview.spec.js --reporter=line",
    "game:home-field:object-candidate-preview": "HOME_FIELD_CANDIDATE_PREVIEW=1 HOME_FIELD_CANDIDATE_ROOT=.agent/home-field-workspace/candidates/object-layer/latest HOME_FIELD_CANDIDATE_IDS=bush_cluster_dark_01,bush_cluster_light_01,leaf_sprout_01 npx playwright test --config=tests/game/playwright.config.js tests/game/home-field-candidate-preview.spec.js --reporter=line",
    "game:home-field:status": "node app/scripts/home-field-status.js",
    "game:fusions:check": "node app/scripts/check-fusion-catalog.js",
    "game:social-preview": "node app/scripts/generate-social-preview.js",
    "game:test": "node --test tests/**/*.test.js",
    "game:test:e2e": "node app/scripts/run-game-e2e.js",
    "game:test:screens": "node app/scripts/run-game-screenshot-check.js",
    "game:test:screens:debug": "node app/scripts/run-game-screenshot-check.js --debug",
    "test": "node --test"
  },
  "dependencies": {
    "@playwright/test": "^1.58.2",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "marked": "^15.0.6",
    "openai": "^4.104.0",
    "pg": "^8.20.0",
    "sequelize": "^6.37.7",
    "sqlite3": "^5.1.7",
    "puppeteer": "^24.7.1",
    "sequelize": "^6.37.8",
    "sqlite3": "^6.0.1",
    "supertest": "^7.2.2",
    "telegram": "^2.26.22",
    "vite": "^8.0.3",
    "vue": "^3.5.31"
  }
}
