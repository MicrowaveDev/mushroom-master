CLIENT_TOKEN=your_telegram_string_session
OPENAI_API_KEY=your_openai_api_key
GEESOME_URL=https://geesome.example/
GEESOME_API_KEY=your_geesome_api_key
TG_CLIENT_API_ID=123456
TG_CLIENT_API_HASH=your_telegram_api_hash
CHANNEL_USERNAME=your_channel_username_link_or_exact_title
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_BOT_USERNAME=your_bot_username
TELEGRAM_MINI_APP_NAME=app
TELEGRAM_GAME_SHORT_NAME=mushroom_master
TELEGRAM_GAME_URL=https://your-domain.example/
TELEGRAM_WEBHOOK_SECRET=replace-with-random-secret
PUBLIC_GAME_URL=https://your-domain.example/
POSTGRES_DB=mushroom_battles
POSTGRES_USER=mushroom_user
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-32
# Docker Compose production sets DATABASE_URL automatically from the
# POSTGRES_* values above. For non-Docker local Postgres, set it manually:
# DATABASE_URL=postgres://mushroom_user:change-me@localhost:5432/mushroom_battles
SQLITE_STORAGE=tmp/telegram-autobattler-dev.sqlite
PORT=3021
BOT_SEND_TO_CHANNEL=false
ADMIN_CHAT_IDS=123456789,987654321
MESSAGE_LIMIT=0
OPENAI_OCR_MODEL=gpt-4.1-mini
OPENAI_LORE_MODEL=gpt-4.1-mini

# Home Field hub (Phase 0 contracts shipped; runtime renderer lands in Phase 3).
# When false, the legacy home dashboard renders. When true, the Phaser hub mounts.
# HOME_FIELD_FORCE_FALLBACK acts as an emergency kill switch (true => legacy dashboard
# everywhere, regardless of HOME_FIELD_ENABLED). See docs/home-field-ingame-plan.md
# and docs/adr/0001-home-field-renderer.md.
HOME_FIELD_ENABLED=false
HOME_FIELD_RENDERER=phaser
HOME_FIELD_FORCE_FALLBACK=false
